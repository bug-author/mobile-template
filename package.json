{
  "name": "mobile-template",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start",
    "start:staging": "APP_VARIANT=staging expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.13.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "expo": "~54.0.20",
    "expo-constants": "^18.0.10",
    "expo-font": "^14.0.9",
    "expo-linking": "^8.0.8",
    "expo-router": "^6.0.13",
    "expo-status-bar": "~3.0.8",
    "nativewind": "^4.2.1",
    "onesignal-expo-plugin": "^2.0.3",
    "posthog-react-native": "^4.10.5",
    "react": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-native": "0.81.5",
    "react-native-onesignal": "^5.2.13",
    "react-native-purchases": "^9.6.0",
    "react-native-purchases-ui": "^9.6.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest-expo": "^54.0.13",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.2"
  },
  "private": true
}
